# ============================================================================
# Engineering Team Dashboard — configuration
#
# Copy this file to  dashboard.env  and edit. Blank lines and #comments are
# ignored. Restart the dashboard after changing anything here.
# ============================================================================

# --- Identity ---------------------------------------------------------------
TEAM_NAME=Engineering

# IANA timezone for the clock, calendar and agenda.
# e.g. America/New_York, America/Chicago, America/Denver, America/Los_Angeles
DASHBOARD_TZ=America/New_York

# --- Where the wall listens --------------------------------------------------
# 127.0.0.1 = this PC only (most secure).
# 0.0.0.0   = reachable from other machines on the LAN, so a few trusted people
#             can edit the board from their desks and watch it change on the TV.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8770

# --- Editing from the LAN ----------------------------------------------------
# The TV itself can always edit the board and coverage. A browser on the LAN is
# read-only UNLESS you set a shared edit key here: then anyone who enters it
# (once, in their browser) can drag cards, update progress and reassign
# coverage. Leave it blank to keep the LAN read-only (the secure default).
# Display controls (minimise / shut down) stay on the TV only, regardless.
# Note: this travels over plain HTTP on your LAN, so treat it as a low-stakes
# shared password on a trusted network, not real authentication.
EDIT_KEY=

# --- Content folders ---------------------------------------------------------
# Leave these unset to use the data\ folder next to the app. Point them at a
# network share to let the whole team drop files in without touching the TV PC:
#   TAKEAWAYS_DIR=\\fileserver\team\dashboard\meeting-takeaways
#   UPDATES_DIR=\\fileserver\team\dashboard\team-updates
#   PROJECTS_DIR=\\fileserver\team\dashboard\projects
# TAKEAWAYS_DIR=
# UPDATES_DIR=
# PROJECTS_DIR=

# Seconds each document is shown before the panel rotates to the next one.
ROTATION_SECONDS=25

# --- Page auto-cycle ---------------------------------------------------------
# The wall cycles its pages (Overview -> Projects -> Coverage) on its own, so an
# unattended TV shows everything. Touching the wall pauses it; it resumes after
# the wall has been left alone for a bit. This is the seconds spent on each page.
# Set to 0 to turn auto-cycling off and leave paging fully manual.
PAGE_CYCLE_SECONDS=20

# --- Travel page: weather + traffic -----------------------------------------
# Weather is the US National Weather Service (free, no key). Point is "lat,lon";
# place is the label shown on the wall. Defaults to Charleston, SC.
WEATHER_POINT=32.7765,-79.9311
WEATHER_PLACE=Charleston County
WEATHER_REFRESH_SECONDS=900

# Road incidents (accidents, jams, closures) come from TomTom. Get a free key at
# developer.tomtom.com and paste it here; leave it blank and the Travel page
# simply shows weather only. bbox is the area to watch, "minLon,minLat,maxLon,
# maxLat" — the default covers greater Charleston. Free tier is generous; the
# 180s refresh is ~480 calls/day.
TRAFFIC_API_KEY=
TRAFFIC_BBOX=-80.20,32.65,-79.75,33.03
TRAFFIC_REFRESH_SECONDS=180

# --- Calendar ----------------------------------------------------------------
# Comma-separated ICS URLs. In Google Calendar this is
#   Settings > (your calendar) > "Secret address in iCal format".
# In Outlook/Microsoft 365 it is Settings > Calendar > Shared calendars >
#   Publish a calendar > ICS link.
#
# Multiple calendars: list several, comma-separated. The wall merges them and
# gives each its own colour plus a small legend. Add a label with "Name = URL"
# so the legend reads well (without one, the calendar's own name or its host is
# used):
#   CALENDAR_ICS_URLS=Team = https://.../team.ics, On-call = https://.../oncall.ics
#
# Each calendar gets an automatic colour. To choose your own, put a #hex after
# the name (an Outlook/Google "Published/Secret address in iCal format" link
# works as the URL):
#   CALENDAR_ICS_URLS=Team #2e8b57 = https://.../team.ics, On-call #d55181 = https://.../oncall.ics
#
# Leave empty for a clean month grid with no events.
CALENDAR_ICS_URLS=
CALENDAR_REFRESH_SECONDS=900
CALENDAR_HORIZON_DAYS=30

# --- News ticker -------------------------------------------------------------
# Comma-separated RSS/Atom feeds. Defaults to major world-news wires.
NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://www.theguardian.com/world/rss
NEWS_REFRESH_SECONDS=600
NEWS_MAX_ITEMS=40
