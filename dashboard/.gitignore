# Local environment
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Real configuration — may contain a secret calendar ICS link.
# Commit dashboard.env.example instead.
dashboard.env

# Runtime state
dashboard.log
dashboard.stdout.log
.dashboard.pid

# Team content: this whole tree is created and maintained on the running
# machine and is NEVER shipped in an update, so a new build cannot overwrite
# the project board or anything the team has posted. Fresh installs seed it
# from samples/ (see Install-Dashboard.ps1). Only the empty-folder markers
# are tracked.
data/*/*
!data/*/.gitkeep
